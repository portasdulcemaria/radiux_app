class ConversionScreen extends StatefulWidget {
  const ConversionScreen({super.key});
  @override
  State<ConversionScreen> createState() => _ConversionScreenState();
}

class _ConversionScreenState extends State<ConversionScreen>
    with AutomaticKeepAliveClientMixin {
  @override
  bool get wantKeepAlive => true;

  final _inputCtrl = TextEditingController();
  final _focus     = FocusNode();
  final _scrollCtrl = ScrollController();

  RadioUnit _from = kUnits.first;
  RadioUnit _to   = kUnits[4];
  double?   _result;
  String?   _error;
  bool      _converted = false;

  @override
  void initState() {
    super.initState();
    _inputCtrl.addListener(() =>
        setState(() { _error = null; _result = null; _converted = false; }));
  }

  @override
  void dispose() {
    _inputCtrl.dispose();
    _focus.dispose();
    _scrollCtrl.dispose();
    super.dispose();
  }

  void _convert() {
    final v = double.tryParse(_inputCtrl.text.replaceAll(',', '.'));
    if (v == null || v <= 0) {
      setState(() => _error = 'Ingresá un número positivo');
      HapticFeedback.mediumImpact();
      return;
    }
    setState(() {
      _result    = DecayService.convert(v, _from, _to);
      _error     = null;
      _converted = true;
    });
    HapticFeedback.lightImpact();
    _focus.unfocus();
    // Announce result to screen readers
    final formatted = '${DecayService.formatActivity(_result!)} ${_to.label}';
    SemanticsService.announce(
        'Resultado: $formatted', 
    // Scroll down so result is visible
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (_scrollCtrl.hasClients) {
        _scrollCtrl.animateTo(
          _scrollCtrl.position.maxScrollExtent,
          duration: const Duration(milliseconds: 400),
          curve: Curves.easeOut,
        );
      }
    });
  }

  void _swap() {
    HapticFeedback.selectionClick();
    setState(() {
      final tmp = _from; _from = _to; _to = tmp;
      _result = null; _converted = false;
    });
    SemanticsService.announce(
        'Intercambiado: de ${_from.label} a ${_to.label}');
  }

  void _reset() {
    HapticFeedback.mediumImpact();
    setState(() {
      _inputCtrl.clear();
      _result = null; _error = null; _converted = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    super.build(context);
    return GestureDetector(
      onTap: () => _focus.unfocus(),
      child: SingleChildScrollView(
        controller: _scrollCtrl,
        keyboardDismissBehavior: ScrollViewKeyboardDismissBehavior.onDrag,
        padding: const EdgeInsets.fromLTRB(20, 24, 20, 40),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [

            // ── Heading ─────────────────────────────────────────────
            _SectionHeading(
              label: 'Conversión',
              sub: 'Unidades de actividad radiactiva',
              hasResult: _converted,
              onReset: _reset,
            ),
            const SizedBox(height: 24),

            // ── Input ───────────────────────────────────────────────
            _BigInput(
              controller: _inputCtrl,
              focus: _focus,
              unit: _from,
              hasError: _error != null,
              onUnitTap: () => _showPicker(isFrom: true),
            ),
            if (_error != null) ...[
              const SizedBox(height: 6),
              _ErrorRow(text: _error!),
            ],
            const SizedBox(height: 16),

            // ── From / Swap / To ────────────────────────────────────
            Row(children: [
              Expanded(child: _UnitBox(
                label: 'Desde', unit: _from,
                color: AppColors.primary,
                onTap: () => _showPicker(isFrom: true),
              )),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 10),
                child: _SwapBtn(onTap: _swap),
              ),
              Expanded(child: _UnitBox(
                label: 'Hacia', unit: _to,
                color: AppColors.accent,
                onTap: () => _showPicker(isFrom: false),
              )),
            ]),
            const SizedBox(height: 20),

            // ── Unit grid ───────────────────────────────────────────
            _UnitGrid(
              from: _from, to: _to,
              onSelect: (u, isFrom) {
                HapticFeedback.selectionClick();
                setState(() {
                  if (isFrom) _from = u; else _to = u;
                  _result = null; _converted = false;
                });
              },
            ),
            const SizedBox(height: 24),

            // ── Convert button ──────────────────────────────────────
            _PrimaryBtn(
              label: 'Convertir',
              icon: Icons.swap_horiz_rounded,
              enabled: _inputCtrl.text.isNotEmpty,
              onTap: _convert,
            ),

            // ── Result ──────────────────────────────────────────────
            if (_converted && _result != null) ...[
              const SizedBox(height: 20),
              TweenAnimationBuilder<double>(
                duration: const Duration(milliseconds: 500),
                curve: Curves.easeOutCubic,
                tween: Tween(begin: 0.0, end: 1.0),
                builder: (_, v, child) => Opacity(
                  opacity: v,
                  child: Transform.translate(
                    offset: Offset(0, (1 - v) * 16),
                    child: Transform.scale(scale: 0.96 + 0.04 * v, child: child),
                  ),
                ),
                child: _ResultHero(
                  input: double.parse(_inputCtrl.text.replaceAll(',', '.')),
                  result: _result!,
                  from: _from, to: _to,
                  onCopy: _copyResult,
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }

  void _copyResult() {
    final text = '${DecayService.formatActivity(_result!)} ${_to.label}';
    Clipboard.setData(ClipboardData(text: text));
    _snack(context, text);
    HapticFeedback.selectionClick();
  }

  void _showPicker({required bool isFrom}) {
    showModalBottomSheet(
      context: context,
      backgroundColor: AppColors.surface,
      shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
      builder: (_) => _UnitSheet(
        selected: isFrom ? _from : _to,
        onPick: (u) {
          HapticFeedback.selectionClick();
          setState(() {
            if (isFrom) _from = u; else _to = u;
            _result = null; _converted = false;
          });
          Navigator.pop(context);
        },
      ),
    );
  }
}

