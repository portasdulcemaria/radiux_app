            label: '${u.label} — ${u.fullName}',
            selected: sel,
            button: true,
            child: ListTile(
              dense: true,
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(10)),
              tileColor: sel ? AppColors.primaryGlow : Colors.transparent,
              title: Text('${u.label} — ${u.fullName}', style: TextStyle(
                color: sel ? AppColors.primaryLight : AppColors.textPrimary)),
              trailing: sel
                  ? ExcludeSemantics(child: const Icon(
                      Icons.check_circle_rounded,
                      color: AppColors.primary, size: 18))
                  : null,
              onTap: () => onPick(u),
            ),
          );
        }),
      ]),
    );
  }
}

// ─── Snackbar helper ──────────────────────────────────────────────────────────
void _snack(BuildContext context, String text) {
  ScaffoldMessenger.of(context).showSnackBar(SnackBar(
    content: Row(children: [
      ExcludeSemantics(child: const Icon(
          Icons.check_circle_rounded, color: AppColors.success, size: 18)),
      const SizedBox(width: 8),
      Text('$text copiado',
          style: const TextStyle(color: AppColors.textPrimary)),
    ]),
    backgroundColor: AppColors.card,
    behavior: SnackBarBehavior.floating,
    margin: const EdgeInsets.all(16),
    shape: RoundedRectangleBorder(
      borderRadius: BorderRadius.circular(10),
      side: const BorderSide(color: AppColors.border)),
    duration: const Duration(seconds: 2),
  ));
}
