// ─── Big input ────────────────────────────────────────────────────────────────
class _BigInput extends StatelessWidget {
  final TextEditingController controller;
  final FocusNode focus;
  final RadioUnit unit;
  final bool hasError;
  final VoidCallback onUnitTap;
  const _BigInput({
    required this.controller, required this.focus,
    required this.unit, required this.hasError,
    required this.onUnitTap,
  });

  @override
  Widget build(BuildContext context) {
    return Semantics(
      label: 'Actividad inicial',
      textField: true,
      child: ListenableBuilder(
        listenable: focus,
        builder: (_, __) {
          final focused = focus.hasFocus;
          return AnimatedContainer(
            duration: const Duration(milliseconds: 180),
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(14),
              border: Border.all(
                color: hasError ? AppColors.error
                    : focused ? AppColors.primary
                    : AppColors.border,
                width: focused || hasError ? 1.5 : 1.0,
              ),
              color: AppColors.card,
              boxShadow: focused && !hasError
                  ? [BoxShadow(color: AppColors.primaryGlow, blurRadius: 16, spreadRadius: 2)]
                  : hasError
                      ? [BoxShadow(color: AppColors.errorGlow, blurRadius: 12)]
                      : null,
            ),
            child: Row(children: [
              Expanded(
                child: TextField(
                  controller: controller,
                  focusNode: focus,
                  keyboardType:
                      const TextInputType.numberWithOptions(decimal: true),
                  inputFormatters: [
                    FilteringTextInputFormatter.allow(RegExp(r'[\d.,]'))],
                  textInputAction: TextInputAction.done,
                  style: const TextStyle(
                    color: AppColors.textPrimary, fontSize: 34,
                    fontWeight: FontWeight.w700, letterSpacing: -1.0),
                  decoration: const InputDecoration(
                    hintText: '0',
                    hintStyle: TextStyle(
                      color: AppColors.textDisabled, fontSize: 34,
                      fontWeight: FontWeight.w700),
                    border: InputBorder.none,
                    enabledBorder: InputBorder.none,
                    focusedBorder: InputBorder.none,
                    contentPadding: EdgeInsets.symmetric(
                        horizontal: 16, vertical: 14),
                    filled: false,
                  ),
                ),
              ),
              // Unit selector — min 44pt touch target
              Semantics(
                label: 'Unidad: ${unit.label}. Toca para cambiar',
                button: true,
                child: GestureDetector(
                  onTap: onUnitTap,
                  child: Container(
                    constraints: const BoxConstraints(minWidth: 64, minHeight: 44),
                    margin: const EdgeInsets.all(8),
                    padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                    decoration: BoxDecoration(
                      color: AppColors.primaryGlow,
                      borderRadius: BorderRadius.circular(10),
                      border: Border.all(
                          color: AppColors.primary.withOpacity(0.35)),
                    ),
                    alignment: Alignment.center,
                    child: Row(mainAxisSize: MainAxisSize.min, children: [
                      Text(unit.label, style: const TextStyle(
                        color: AppColors.primaryLight,
                        fontSize: 14, fontWeight: FontWeight.w700)),
                      const SizedBox(width: 4),
                      const Icon(Icons.expand_more_rounded,
                          color: AppColors.primaryLight, size: 16),
                    ]),
                  ),
