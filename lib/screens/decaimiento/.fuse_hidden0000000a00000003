class DecaimientoScreen extends StatefulWidget {
  const DecaimientoScreen({super.key});
  @override
  State<DecaimientoScreen> createState() => _DecaimientoScreenState();
}

class _DecaimientoScreenState extends State<DecaimientoScreen>
    with AutomaticKeepAliveClientMixin {
  @override
  bool get wantKeepAlive => true;

  final _ctrl       = TextEditingController();
  final _focus      = FocusNode();
  final _scroll     = ScrollController();

  RadioUnit _unit       = kUnits[4];
  Isotope   _isotope    = kIsotopes.first;
  DateTime  _refDate    = DateTime.now();
  double    _addedHours = 0;
  int?      _quickIdx;
  double?   _result;
  String?   _error;
  bool      _busy       = false;

  DateTime get _targetDate =>
      _refDate.add(Duration(minutes: (_addedHours * 60).round()));
  double?  get _a0 =>
      double.tryParse(_ctrl.text.replaceAll(',', '.'));
  bool get _canCalc =>
      _ctrl.text.isNotEmpty && (_a0 ?? 0) > 0 && _addedHours > 0;

  List<_QOpt> get _opts => [
    _QOpt('+1h',  1),
    _QOpt('+6h',  6),
    _QOpt('+12h', 12),
    _QOpt('+24h', 24),
    _QOpt('+T½',  _isotope.halfLifeHours, isHL: true),
  ];

  @override
  void initState() {
    super.initState();
    _ctrl.addListener(() =>
        setState(() { _error = null; _result = null; }));
  }

  @override
  void dispose() {
    _ctrl.dispose(); _focus.dispose(); _scroll.dispose();
    super.dispose();
  }

  void _pickQuick(int i) {
    HapticFeedback.selectionClick();
    final newIdx = _quickIdx == i ? null : i;
    setState(() {
      _quickIdx    = newIdx;
      _addedHours  = newIdx == null ? 0 : _opts[i].hours;
      _result      = null;
    });
    if (newIdx != null) {
      final pct = (math.pow(2, -_opts[i].hours / _isotope.halfLifeHours) * 100)
          .toStringAsFixed(1);
      SemanticsService.announce(
          '${_opts[i].label} seleccionado. $pct% de actividad estimada');
    }
  }

  Future<void> _pickDate() async {
    final d = await showDatePicker(
      context: context,
      initialDate: _refDate,
      firstDate: DateTime(2000), lastDate: DateTime(2100),
      builder: (ctx, child) => Theme(
        data: Theme.of(ctx).copyWith(
          colorScheme: const ColorScheme.dark(
            primary: AppColors.primary, surface: AppColors.card,
            onSurface: AppColors.textPrimary),
          dialogTheme: const DialogThemeData(backgroundColor: AppColors.surface),
        ),
        child: child!,
      ),
    );
    if (d == null || !mounted) return;
    final t = await showTimePicker(
      context: context,
      initialTime: TimeOfDay.fromDateTime(_refDate),
      builder: (ctx, child) => Theme(
        data: Theme.of(ctx).copyWith(
          colorScheme: const ColorScheme.dark(
            primary: AppColors.primary, surface: AppColors.card,
            onSurface: AppColors.textPrimary),
          timePickerTheme:
              const TimePickerThemeData(backgroundColor: AppColors.surface),
        ),
        child: child!,
      ),
    );
    final time = t ?? TimeOfDay.fromDateTime(_refDate);
    if (!mounted) return;
    setState(() {
      _refDate = DateTime(d.year, d.month, d.day, time.hour, time.minute);
      _result  = null;
    });
    HapticFeedback.lightImpact();
  }

  Future<void> _calculate() async {
    if (!_canCalc) {
      final msg = (_a0 == null || _a0! <= 0)
          ? 'Ingresá un valor de actividad positivo'
          : 'Seleccioná un tiempo transcurrido';
      setState(() => _error = msg);
      HapticFeedback.mediumImpact();
      return;
    }
    setState(() { _busy = true; _error = null; });
    await Future.delayed(const Duration(milliseconds: 360));
    final r = DecayService.decay(
      initialActivity: _a0!,
      halfLifeHours: _isotope.halfLifeHours,
      elapsedHours: _addedHours,
    );
    if (!mounted) return;
    setState(() { _result = r; _busy = false; });
    HapticFeedback.lightImpact();
    // Announce result
    final formatted = '${DecayService.formatActivity(r)} ${_unit.label}';
    SemanticsService.announce(
        'Actividad residual: $formatted', 
    // Scroll to result
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (_scroll.hasClients) {
        _scroll.animateTo(
          _scroll.position.maxScrollExtent,
          duration: const Duration(milliseconds: 400),
          curve: Curves.easeOut,
        );
      }
    });
  }

  void _reset() {
    HapticFeedback.mediumImpact();
    setState(() {
      _ctrl.clear(); _addedHours = 0; _quickIdx = null;
      _result = null; _error = null; _refDate = DateTime.now();
    });
  }

  @override
  Widget build(BuildContext context) {
    super.build(context);
    return GestureDetector(
      onTap: () => _focus.unfocus(),
      child: Stack(children: [
        SingleChildScrollView(
          controller: _scroll,
          keyboardDismissBehavior: ScrollViewKeyboardDismissBehavior.onDrag,
          padding: const EdgeInsets.fromLTRB(20, 24, 20, 140),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [

              // ── Heading ──────────────────────────────────────────
              _SectionHeading(
                hasResult: _result != null,
                onReset: _reset,
              ),
              const SizedBox(height: 28),

              // ── Activity input ───────────────────────────────────
              const _Label('Actividad inicial'),
              const SizedBox(height: 8),
              _BigInput(
                controller: _ctrl, focusNode: _focus,
                unit: _unit, hasError: _error != null,
                onUnitTap: _showUnitSheet,
              ),
              if (_error != null) ...[
                const SizedBox(height: 6),
                _ErrorRow(text: _error!),
              ],
              const SizedBox(height: 22),

              // ── Isotope ──────────────────────────────────────────
              const _Label('Isótopo'),
              const SizedBox(height: 8),
              _IsotopeCard(isotope: _isotope, onTap: _showIsotopeSheet),
              const SizedBox(height: 22),

              // ── Reference date ───────────────────────────────────
              Row(children: [
                const Expanded(child: _Label('Fecha y hora de referencia')),
                _EditDateBtn(onTap: _pickDate),
              ]),
              const SizedBox(height: 8),
              _DateChip(dateTime: _refDate),
              const SizedBox(height: 22),

              // ── Quick time ───────────────────────────────────────
              const _Label('Tiempo transcurrido'),
              const SizedBox(height: 10),
              _QuickRow(opts: _opts, selected: _quickIdx, onPick: _pickQuick),

              if (_quickIdx != null) ...[
                const SizedBox(height: 10),
                TweenAnimationBuilder<double>(
                  key: ValueKey(_quickIdx),
                  duration: const Duration(milliseconds: 300),
                  curve: Curves.easeOut,
                  tween: Tween(begin: 0.0, end: 1.0),
                  builder: (_, v, child) => Opacity(
                    opacity: v,
                    child: Transform.translate(
                        offset: Offset(0, (1 - v) * 10), child: child),
                  ),
                  child: _TargetCard(
                    target: _targetDate,
                    hours: _addedHours,
                    isotope: _isotope,
                  ),
                ),
              ],
              const SizedBox(height: 28),

              // ── Result ───────────────────────────────────────────
              if (_result != null && _a0 != null)
                TweenAnimationBuilder<double>(
                  duration: const Duration(milliseconds: 500),
                  curve: Curves.easeOutCubic,
                  tween: Tween(begin: 0.0, end: 1.0),
                  builder: (_, v, child) => Opacity(
                    opacity: v,
                    child: Transform.translate(
                      offset: Offset(0, (1 - v) * 18),
                      child: Transform.scale(
                          scale: 0.96 + 0.04 * v, child: child),
                    ),
                  ),
                  child: _ResultHero(
                    a0: _a0!, result: _result!,
                    unit: _unit, isotope: _isotope, hours: _addedHours,
                    onCopy: _copyResult,
                    onReset: _reset,
                  ),
                ),
            ],
          ),
        ),

        // ── Pinned footer ────────────────────────────────────────────
        Positioned(
          left: 0, right: 0, bottom: 0,
          child: _CalcFooter(
            canCalc: _canCalc, busy: _busy, onTap: _calculate),
        ),
      ]),
    );
  }

  void _copyResult() {
    final text = '${DecayService.formatActivity(_result!)} ${_unit.label}';
    Clipboard.setData(ClipboardData(text: text));
    _snack(context, text);
    HapticFeedback.selectionClick();
  }

  void _showUnitSheet() {
    showModalBottomSheet(
      context: context,
      backgroundColor: AppColors.surface,
      shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
      builder: (_) => _UnitSheet(
        selected: _unit,
        onPick: (u) {
          setState(() { _unit = u; _result = null; });
          Navigator.pop(context);
        },
      ),
    );
  }

  void _showIsotopeSheet() {
    showModalBottomSheet(
      context: context,
      backgroundColor: AppColors.surface,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
      builder: (_) => DraggableScrollableSheet(
        initialChildSize: 0.6, minChildSize: 0.4, maxChildSize: 0.9,
        expand: false,
        builder: (_, sc) => _IsotopeSheet(
          selected: _isotope, scroll: sc,
          onPick: (iso) {
            HapticFeedback.selectionClick();
            setState(() {
              _isotope = iso; _quickIdx = null;
              _addedHours = 0; _result = null;
            });
            Navigator.pop(context);
          },
        ),
      ),
    );
  }
}

