  final double a0, result, hours;
  final RadioUnit unit;
  final Isotope isotope;
  final VoidCallback onCopy, onReset;
  const _ResultHero({
    required this.a0, required this.result, required this.unit,
    required this.isotope, required this.hours,
    required this.onCopy, required this.onReset,
  });

  @override
  Widget build(BuildContext context) {
    final fraction  = result / a0;
    final pct       = (fraction * 100).toStringAsFixed(2);
    final halfLives = (hours / isotope.halfLifeHours).toStringAsFixed(2);
    final reduction = (100 - fraction * 100).toStringAsFixed(2);
    final formatted = DecayService.formatActivity(result);

    return GlassCard(
      hasBorderGlow: true, glowColor: AppColors.primary, isActive: true,
      padding: const EdgeInsets.all(20),
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [

        // Header
        Row(children: [
          ExcludeSemantics(child: _IsoPill(isotope: isotope, size: 48)),
          const SizedBox(width: 12),
          Expanded(child: Column(
              crossAxisAlignment: CrossAxisAlignment.start, children: [
            const Text('Actividad residual', style: TextStyle(
