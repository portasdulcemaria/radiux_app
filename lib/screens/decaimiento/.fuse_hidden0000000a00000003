// ─── Quick time row ───────────────────────────────────────────────────────────
class _QuickRow extends StatelessWidget {
  final List<_QOpt> opts;
  final int? selected;
  final ValueChanged<int> onPick;
  const _QuickRow({required this.opts, required this.selected, required this.onPick});

  @override
  Widget build(BuildContext context) {
    return Row(
      children: opts.asMap().entries.map((e) {
        final i = e.key; final o = e.value;
        final sel = selected == i;
        return Expanded(
          child: Semantics(
            label: o.isHL
                ? 'Una vida media: ${o.hours.toStringAsFixed(1)} horas'
                : o.label,
            selected: sel,
            button: true,
            child: GestureDetector(
              onTap: () => onPick(i),
              child: AnimatedContainer(
                duration: const Duration(milliseconds: 200),
                margin: EdgeInsets.only(right: i < opts.length - 1 ? 6 : 0),
                constraints: const BoxConstraints(minHeight: 44),
                padding: const EdgeInsets.symmetric(vertical: 12),
                decoration: BoxDecoration(
                  color: sel ? AppColors.primaryGlow : AppColors.card,
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(
                    color: sel ? AppColors.primary : AppColors.border,
                    width: sel ? 1.5 : 1.0),
                  boxShadow: sel
                      ? [BoxShadow(color: AppColors.primaryGlow, blurRadius: 8)]
                      : null,
                ),
                alignment: Alignment.center,
                child: Text(o.label, style: TextStyle(
                  color: sel ? AppColors.primaryLight : AppColors.textSecondary,
                  fontSize: 12,
                  fontWeight: sel ? FontWeight.w700 : FontWeight.w500)),
              ),
            ),
          ),
        );
      }).toList(),
    );
  }
}

