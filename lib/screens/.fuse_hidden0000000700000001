// ─── Tab row ──────────────────────────────────────────────────────────────────
class _TabRow extends StatelessWidget {
  final int current;
  final ValueChanged<int> onTab;
  const _TabRow({required this.current, required this.onTab});

  @override
  Widget build(BuildContext context) {
    return Container(
      height: 44, // ≥ 44pt Apple HIG minimum
      decoration: BoxDecoration(
        color: AppColors.surface,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: AppColors.border, width: 0.5),
      ),
      child: Row(children: [
        _Tab(
          label: 'Conversión',
          icon: Icons.swap_horiz_rounded,
          selected: current == 0,
          onTap: () => onTab(0),
        ),
        ExcludeSemantics(
          child: Container(width: 0.5, color: AppColors.border),
        ),
        _Tab(
          label: 'Decaimiento',
          icon: Icons.science_outlined,
          selected: current == 1,
          onTap: () => onTab(1),
        ),
      ]),
    );
  }
}

class _Tab extends StatefulWidget {
  final String label;
  final IconData icon;
  final bool selected;
  final VoidCallback onTap;
  const _Tab({
    required this.label, required this.icon,
    required this.selected, required this.onTap,
  });
  @override
  State<_Tab> createState() => _TabState();
}

class _TabState extends State<_Tab> with SingleTickerProviderStateMixin {
  late final AnimationController _press;

  @override
  void initState() {
    super.initState();
    _press = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 80),
      reverseDuration: const Duration(milliseconds: 200),
    );
  }

  @override
  void dispose() { _press.dispose(); super.dispose(); }

  @override
  Widget build(BuildContext context) {
    return Expanded(
      child: Semantics(
        label: widget.label,
        selected: widget.selected,
        button: true,
        // Hint read by VoiceOver when not selected
        hint: widget.selected ? null : 'Ir a ${widget.label}',
        child: GestureDetector(
          onTapDown: (_) => _press.forward(),
          onTapUp: (_) { _press.reverse(); widget.onTap(); },
          onTapCancel: () => _press.reverse(),
          // Full-height hit area — no accidental misses
          behavior: HitTestBehavior.opaque,
          child: AnimatedBuilder(
            animation: _press,
            builder: (_, child) => Transform.scale(
              scale: 1.0 - 0.04 * _press.value,
              child: child,
            ),
            child: AnimatedContainer(
              duration: const Duration(milliseconds: 200),
              curve: Curves.easeInOut,
              margin: const EdgeInsets.all(4),
              decoration: BoxDecoration(
                color: widget.selected
                    ? AppColors.primary.withOpacity(0.14)
                    : Colors.transparent,
                borderRadius: BorderRadius.circular(8),
                border: widget.selected
                    ? Border.all(
                        color: AppColors.primary.withOpacity(0.32), width: 0.5)
                    : null,
              ),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  ExcludeSemantics(
                    child: Icon(
                      widget.icon,
                      size: 14,
                      color: widget.selected
                          ? AppColors.primaryLight
                          : AppColors.textDisabled,
                    ),
                  ),
                  const SizedBox(width: 5),
                  AnimatedDefaultTextStyle(
                    duration: const Duration(milliseconds: 200),
                    style: TextStyle(
                      fontSize: 12.5,
                      fontWeight: widget.selected
                          ? FontWeight.w600 : FontWeight.w400,
                      color: widget.selected
                          ? AppColors.primaryLight
                          : AppColors.textDisabled,
                      letterSpacing: -0.1,
                    ),
                    child: Text(widget.label),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}
