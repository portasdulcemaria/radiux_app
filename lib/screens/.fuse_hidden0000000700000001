            child: Row(
              crossAxisAlignment: CrossAxisAlignment.center,
              children: [
                // Logo — purely decorative, excluded from a11y tree
                ExcludeSemantics(
                  child: _LogoMark(),
                ),
                const SizedBox(width: 10),
                // App name as heading
                Semantics(
                  header: true,
                  child: const Text(
                    'Radiux',
                    style: TextStyle(
                      fontSize: 18, fontWeight: FontWeight.w800,
                      color: AppColors.textPrimary, letterSpacing: -0.7),
                  ),
                ),
                const SizedBox(width: 8),
                // Status dot — decorative
                ExcludeSemantics(
                  child: Container(
                    width: 5, height: 5,
                    decoration: const BoxDecoration(
                      shape: BoxShape.circle,
                      color: Color(0xFF10B981),
                      boxShadow: [BoxShadow(
                        color: Color(0x9910B981), blurRadius: 6)],
                    ),
                  ),
                ),
                const Spacer(),
                // Version badge — decorative
                ExcludeSemantics(
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 9, vertical: 3),
                    decoration: BoxDecoration(
                      color: AppColors.primaryGlow,
                      borderRadius: BorderRadius.circular(20),
                      border: Border.all(
                        color: AppColors.primary.withOpacity(0.28), width: 0.5),
